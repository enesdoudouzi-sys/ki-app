# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Model API (required) ---
# Create a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# --- Login (required) ---
# Random secret that encrypts session cookies. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the app.
NEXTAUTH_URL=http://localhost:3000
# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Comma-separated GitHub usernames that may sign in. Empty admits no one; * admits any account.
AUTH_ALLOWED_USERS=

# --- Optional overrides (defaults shown) ---
# ANTHROPIC_MODEL=claude-opus-5-5
# CHAT_MAX_OUTPUT_TOKENS=16000
# CHAT_RATE_LIMIT_PER_MINUTE=20
