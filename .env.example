# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Model API (required) ---
# Default provider is Google Gemini. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# To use Anthropic instead, set AI_PROVIDER=anthropic and ANTHROPIC_API_KEY
# (key from https://platform.claude.com/).
# AI_PROVIDER=gemini
# ANTHROPIC_API_KEY=

# --- Login (required) ---
# Random secret that encrypts session cookies. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the app.
NEXTAUTH_URL=http://localhost:3000
# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Comma-separated GitHub usernames that may sign in. Empty admits no one; * admits any account.
AUTH_ALLOWED_USERS=

# --- Optional overrides (defaults shown) ---
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-opus-5-5
# CHAT_MAX_OUTPUT_TOKENS=16000
# CHAT_RATE_LIMIT_PER_MINUTE=20

# Wissenssuche mit Quellen (optional)
# RAG_ENABLED=true
# RAG_SOURCE_DIR=node_modules/next/dist/docs/01-app
# RAG_SOURCE_URL_BASE=https://nextjs.org/docs/app/
